{
    "defaults": {
      "description": "UMItools workflow test",
      "metrics_calculate": "calculate.sh",
      "metrics_compare": "compare.sh",
      "output_metrics_dir": "/.mounts/labs/gsi/testdata/umiExtract/output_metrics",
      "parameters": {
        "wdl_options": {
          "write_to_cache": false,
          "read_from_cache": false
        }
      }
    },
    "tests": [
        {
          "id": "workflow_test_01",
          "parameters": {
            "wdl_inputs": {
                "umiTools.outFileNamePrefix2": "OUTPUT_Test_R2",
                "umiTools.outFileNamePrefix1": "OUTPUT_Test_R1",
                "umiTools.regex": "'(?P<umi_1>.{3}[ACGN])(?P<discard_1>T)|(?P<umi_1>.{3})(?P<discard_1>T.)'",
                "umiTools.logNamePrefix": "log",
                "umiTools.fastq1": "/.mounts/labs/gsi/testdata/umiExtract/test_inputs/r1.fastq",
                "umiTools.fastq2": "/.mounts/labs/gsi/testdata/umiExtract/test_inputs/r2.fastq"
            }
          }
        },
        {
            "id": "workflow_test_02",
            "parameters": {
              "wdl_inputs": {
                  "umiTools.outFileNamePrefix2": "OUTPUT_Test_R2",
                  "umiTools.outFileNamePrefix1": "OUTPUT_Test_R1",
                  "umiTools.regex": "'(?P<umi_1>.{3})(?P<discard_1>.{2})'",
                  "umiTools.logNamePrefix": "log",
                  "umiTools.fastq1": "/.mounts/labs/gsi/testdata/umiExtract/test_inputs/r1.fastq",
                  "umiTools.fastq2": "/.mounts/labs/gsi/testdata/umiExtract/test_inputs/r2.fastq"
              }
            }
        }
    ]                                                                                                                                                                                                                                                                                                                                                                                          
}
